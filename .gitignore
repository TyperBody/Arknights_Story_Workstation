# ============ Logs ============
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============ Node ============
node_modules
dist
dist-ssr
.env*.local

# ============ Unified build output ============
# Frontend bundle + installers/APK + 编译缓存/日志。Supersedes build/ctx & build/fanfic。
# 例外：`build/harness/**` 是**手工维护的验收入口**（每项自带断言 + 退出码），
# 与 `scripts/harness/run.mjs` 一起对外、需要进版本库。
# 注意：`/build/` 会**连目录一起**排除，导致后面的 `!/build/harness/` 无效
#（git 的规则：父目录被排除时不能再 re-include 子路径）——必须用 `/build/*`。
/build/*
!/build/harness/
!/build/harness/**
# harness 的**截图 / 快照**（每次跑都重写）不入库；`.mjs` / `.md` 入库。
build/harness/shots/
build/harness/*.png
# 项目内工具链（rustup/cargo + 交叉编译 target ≈5 GB）：拉取后自动装。
build/toolchain/
# 中间产物 / 探针输出 / 安装包（`build/` 里除 harness 外的全部）。
build/*.json
build/probe-fb/
build/artifacts/
build/fanfic/

# ============ Tauri ============
src-tauri/target/
# Generated capability schemas (regenerated by tauri build); not source.
src-tauri/gen/schemas/
# Apple scaffold (not building iOS); ignore if/when generated.
src-tauri/gen/apple/
# NOTE: src-tauri/gen/android IS version-controlled (customizable Gradle/
# manifest/signing files). Its nested .gitignore excludes build outputs.

# ============ Reference docs (downloaded, large) ============
docs/reference/

# ============ Starter assets (~1 GB; opt-in via manifest) ============
# Only manifests are tracked; run `npm run assets:starter` to fill files.
# `assets/sample/**` IS tracked — embedded via Rust include_bytes!.
src-tauri/resources/assets/starter/*
!src-tauri/resources/assets/starter/curated.json
!src-tauri/resources/assets/starter/bundles.json
!src-tauri/resources/assets/starter/SOURCES.md

# ============ Scratch artifacts at repo root ============
# scripts/precommit-clean.sh also removes these before commit.
/error.txt
/image.png
/image*.png
/screenshot*.png
Screenshot_*.jpg
Screenshot_*.png
/ref/

# ============ Editors / OS ============
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.playwright-mcp/

# ============ Fanfic library ============
# Embedded sample pack (read via include_str!).
!src-tauri/resources/library/sample-fanfic/build/runtime.json